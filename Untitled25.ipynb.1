      "source": [
        "find_median <- function(x) {\n",
        "    x <- sort(x)\n",
        "      n <- length(x)\n",
        "        if (n %% 2 == 1) {\n",
        "            x[(n + 1) / 2]\n",
        "              } else {\n",
        "                  (x[n / 2] + x[n / 2 + 1]) / 2\n",
        "                    }\n",
        "                    }\n",
        "                    X <- c(3, 7, 2, 9, 5)\n",
        "                    find_median(X)"
      ]
    }
  ]
